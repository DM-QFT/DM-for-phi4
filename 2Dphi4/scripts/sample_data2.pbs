#!/bin/bash -l
#PBS -q regular-g
#PBS -l select=20
#PBS -l walltime=00:10:00
#PBS -W group_list=gw97
#PBS -N dm_sample_data2
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# Sample 20 log-spaced checkpoints of
#   runs/phi4_L128_k0.2705_l0.022_ncsnpp_sigma450/
# in parallel, one ckpt per node, on 20 GB200 nodes.
#
# Per call:
#   - 512 raw samples, EM/SDE, 2000 steps, log schedule, seed=20260524
#   - NO Z2 augmentation (saved N = 512); analysis code applies Z2 on load.
#   - Output: runs/.../data2/samples_em_steps2000_epoch=XXXX.npy
#     (data/ holds the older N=2048 files, left untouched)
#
# Submit:   qsub scripts/sample_data2.pbs
# Dry run:  bash scripts/sample_data2.pbs   (will skip mpirun if no PBS env)

set -e

cd ${PBS_O_WORKDIR:-$(pwd)}

K=0.2705
L=128
SIGMA=450
RUN_SUFFIX=_sigma450
OUT_SUBDIR=data2
RUN_DIR="runs/phi4_L${L}_k${K}_l0.022_ncsnpp${RUN_SUFFIX}"

# 20 epoch tags geom-spaced over [1, 10000] across the 84 ckpts present.
EPOCHS=(0001 0002 0003 0004 0007 0011 0019 0031 0049 0079 \
        0126 0200 0351 0559 0890 1417 2257 3944 6280 10000)

# ---- Pre-flight: validate all ckpts exist before launching mpirun. ----
MISSING=()
for ep in "${EPOCHS[@]}"; do
    [[ -f "${RUN_DIR}/models/epoch=${ep}.ckpt" ]] || MISSING+=("$ep")
done
if (( ${#MISSING[@]} > 0 )); then
    echo "ERROR: missing ckpts in ${RUN_DIR}/models/:"
    for ep in "${MISSING[@]}"; do echo "  epoch=${ep}.ckpt"; done
    exit 1
fi

mkdir -p "${RUN_DIR}/${OUT_SUBDIR}"

cat <<EOF
========================================
Job ID    : ${PBS_JOBID:-<no-pbs>}
Start     : $(date '+%F %T')
Workdir   : $(pwd)
Run dir   : ${RUN_DIR}
Out subdir: ${OUT_SUBDIR}
Nodes     : $(uniq ${PBS_NODEFILE:-/dev/null} 2>/dev/null | tr '\n' ' ')
N_epochs  : ${#EPOCHS[@]}
Epochs    : ${EPOCHS[@]}
========================================
EOF

if [[ -z "${PBS_NODEFILE:-}" ]]; then
    echo "(no PBS_NODEFILE — preflight only; not launching mpirun)"
    exit 0
fi

N_NODES=$(uniq "${PBS_NODEFILE}" | wc -l)
N_EPOCHS=${#EPOCHS[@]}

# Round-robin: rank r gets epochs r, r+N_NODES, r+2*N_NODES, ...
declare -a CHUNKS
for ((i=0; i<N_NODES; i++)); do CHUNKS[$i]=""; done
for ((i=0; i<N_EPOCHS; i++)); do
    r=$((i % N_NODES))
    if [[ -z "${CHUNKS[$r]}" ]]; then
        CHUNKS[$r]="${EPOCHS[$i]}"
    else
        CHUNKS[$r]="${CHUNKS[$r]},${EPOCHS[$i]}"
    fi
done

echo "=== Distribution (${N_EPOCHS} epochs -> ${N_NODES} nodes) ==="
i=0
for n in $(uniq "${PBS_NODEFILE}"); do
    echo "  $n (rank $i): ${CHUNKS[$i]:-<idle>}"
    i=$((i+1))
done
echo

# Join CHUNKS with ';' (safer than space when passing through mpirun argv).
OLD_IFS="$IFS"; IFS=";"
CHUNKS_STR="${CHUNKS[*]}"
IFS="$OLD_IFS"

mpirun --map-by ppr:1:node -hostfile "${PBS_NODEFILE}" \
    bash "${PBS_O_WORKDIR}/scripts/sample_data2_worker.sh" \
        "${CHUNKS_STR}" "${K}" "${L}" "${SIGMA}" "${RUN_SUFFIX}" "${OUT_SUBDIR}"

echo
echo "Finished : $(date '+%F %T')"
