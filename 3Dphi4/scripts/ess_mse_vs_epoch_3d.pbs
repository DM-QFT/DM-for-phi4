#!/bin/bash -l
#PBS -q short-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=gw97
#PBS -N dm_ess3d
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# MSE-equivalent ESS vs training epoch, 3D phi^4.  CPU-only analysis on
# PRE-GENERATED raw DM samples.  Runs on Miyabi-G because nenv2 is
# aarch64.  Sample generation is done separately.  HMC ref file is ~5 GB
# for L=64; reading it dominates the walltime.

set -e

cd ${PBS_O_WORKDIR}

JID=${PBS_JOBID%.opbs}
echo "================================================================"
echo "Job ID    : ${PBS_JOBID}"
echo "Node      : $(hostname)"
echo "Start     : $(date '+%F %T')"
echo "================================================================"

bash scripts/ess_mse_vs_epoch_and_run_3d.sh

echo
echo "Finished : $(date '+%F %T')"
