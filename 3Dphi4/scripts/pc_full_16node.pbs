#!/bin/bash -l
#PBS -q regular-g
#PBS -l select=16
#PBS -l walltime=01:30:00
#PBS -W group_list=gw97
#PBS -N dm3d_pcfull
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# Full-corrector PC scan at kappa_c: corrector_tmax=1.0 (correctors at all
# noise scales), settings pc in {5,10}, 8 shards each = 16 nodes.
# 16 nodes -> regular-g routes to small-g.
#
# Merge:  python scripts/merge_pc_shards.py --pc 5  --tag pcfull
#         python scripts/merge_pc_shards.py --pc 10 --tag pcfull

set -e
cd /work/gw97/w97000/project/DM/3Dphi4
RD="runs/phi4_3d_Lmulti4-8-16-32_k0.1923_l0.9_ncsnpp"
[[ -f "$RD/models/epoch=10000.ckpt" ]] || { echo "ERROR: missing ckpt"; exit 1; }
mkdir -p results/mala_pipeline_logs
echo "Job ${PBS_JOBID:-?}  start $(date '+%F %T')  nodes: $(uniq ${PBS_NODEFILE:-/dev/null} 2>/dev/null | wc -l)"
if [[ "${PBS_JOBNAME:-}" != "dm3d_pcfull" ]]; then
    echo "(not the dm3d_pcfull job — preflight only)"; exit 0
fi
mpirun --map-by ppr:1:node -hostfile "${PBS_NODEFILE}" \
    bash /work/gw97/w97000/project/DM/3Dphi4/scripts/pc_full_worker.sh
echo "Finished $(date '+%F %T')"
