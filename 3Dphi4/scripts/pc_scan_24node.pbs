#!/bin/bash -l
#PBS -q regular-g
#PBS -l select=24
#PBS -l walltime=01:30:00
#PBS -W group_list=gw97
#PBS -N dm3d_pcscan
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# 24-node predictor-corrector scan at kappa_c: corrector_steps in {5,10,20},
# 8 shards each, fully parallel. 24 nodes -> regular-g routes to medium-g.
#
# Submit:  qsub scripts/pc_scan_24node.pbs
# Merge:   for PC in 5 10 20; do
#            python scripts/merge_pc_shards.py --pc $PC ; done

set -e
cd /work/gw97/w97000/project/DM/3Dphi4
RD="runs/phi4_3d_Lmulti4-8-16-32_k0.1923_l0.9_ncsnpp"
[[ -f "$RD/models/epoch=10000.ckpt" ]] || { echo "ERROR: missing ckpt"; exit 1; }
mkdir -p results/mala_pipeline_logs
echo "Job ${PBS_JOBID:-?}  start $(date '+%F %T')  nodes: $(uniq ${PBS_NODEFILE:-/dev/null} 2>/dev/null | wc -l)"
if [[ "${PBS_JOBNAME:-}" != "dm3d_pcscan" ]]; then
    echo "(not the dm3d_pcscan job — preflight only)"; exit 0
fi
mpirun --map-by ppr:1:node -hostfile "${PBS_NODEFILE}" \
    bash /work/gw97/w97000/project/DM/3Dphi4/scripts/pc_scan_worker.sh
echo "Finished $(date '+%F %T')"
