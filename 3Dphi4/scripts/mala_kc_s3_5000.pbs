#!/bin/bash -l
#PBS -q short-g
#PBS -l select=8
#PBS -l walltime=01:30:00
#PBS -W group_list=gw97
#PBS -N dm3d_kc_s3l
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# kappa_c, learned-score MALA c=3, 5000 steps, full recipe.
# Submit:  qsub scripts/mala_kc_s3_5000.pbs
# Merge:   python scripts/merge_mala_shards.py --tag kc_s3_5000 --kappas 0.1923

set -e
cd /work/gw97/w97000/project/DM/3Dphi4
RD="runs/phi4_3d_Lmulti4-8-16-32_k0.1923_l0.9_ncsnpp"
for f in "$RD/models/epoch=10000.ckpt" \
         "$RD/data_crossL/samples_filtered512_k0.1923_ep10000.npy"; do
    [[ -f "$f" ]] || { echo "ERROR: missing $f"; exit 1; }
done
mkdir -p results/mala_pipeline_logs
echo "Job ${PBS_JOBID:-?}  start $(date '+%F %T')  nodes: $(uniq ${PBS_NODEFILE:-/dev/null} 2>/dev/null | tr '\n' ' ')"
if [[ "${PBS_JOBNAME:-}" != "dm3d_kc_s3l" ]]; then
    echo "(not the dm3d_kc_s3l job — preflight only)"; exit 0
fi
mpirun --map-by ppr:1:node -hostfile "${PBS_NODEFILE}" \
    bash /work/gw97/w97000/project/DM/3Dphi4/scripts/mala_kc_worker_gen.sh \
        score 3 5000 kc_s3_5000 700
echo "Finished $(date '+%F %T')"
