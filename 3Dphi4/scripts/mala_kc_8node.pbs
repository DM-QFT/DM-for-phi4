#!/bin/bash -l
#PBS -q regular-g
#PBS -l select=8
#PBS -l walltime=01:00:00
#PBS -W group_list=gw97
#PBS -N dm3d_mala_kc
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# kappa_c=0.1923 shift-width test: identical to the prod512f_2000 recipe
# except shift_std reduced 10x (0.1168 -> 0.0117), so the global shift
# operates near its optimal random-walk acceptance instead of ~0.01.
#
# Submit:   qsub scripts/mala_kc_8node.pbs
# Merge:    python scripts/merge_mala_shards.py --tag prod512f_2000_kcS --kappas 0.1923

set -e
cd /work/gw97/w97000/project/DM/3Dphi4

RD="runs/phi4_3d_Lmulti4-8-16-32_k0.1923_l0.9_ncsnpp"
for f in "$RD/models/epoch=10000.ckpt" \
         "$RD/data_crossL/samples_filtered512_k0.1923_ep10000.npy"; do
    [[ -f "$f" ]] || { echo "ERROR: missing $f"; exit 1; }
done
mkdir -p results/mala_pipeline_logs

cat <<EOF
========================================
Job ID  : ${PBS_JOBID:-<no-pbs>}
Start   : $(date '+%F %T')
Nodes   : $(uniq ${PBS_NODEFILE:-/dev/null} 2>/dev/null | tr '\n' ' ')
Test    : kappa_c shift_std 0.1168 -> 0.0117, all else = prod512f_2000
========================================
EOF

if [[ "${PBS_JOBNAME:-}" != "dm3d_mala_kc" ]]; then
    echo "(not the dm3d_mala_kc job — preflight only)"
    exit 0
fi

mpirun --map-by ppr:1:node -hostfile "${PBS_NODEFILE}" \
    bash /work/gw97/w97000/project/DM/3Dphi4/scripts/mala_kc_worker.sh

echo "Finished : $(date '+%F %T')"
