#!/bin/bash -l
#PBS -q short-g
#PBS -l select=8
#PBS -l walltime=00:30:00
#PBS -W group_list=gw97
#PBS -N dm3d_kc_exr
#PBS -j oe
#PBS -m abe
#PBS -M yangyang-tan@g.ecc.u-tokyo.ac.jp

# Resume the exact-c100 kappa_c chain from step 2000 to 5000, 8 shards in
# parallel (one node per shard). Idempotent for already-completed shards.
#
# Submit:  qsub scripts/mala_kc_ex_resume.pbs
# Merge:   python scripts/merge_mala_shards.py --tag kc_ex100_2000 --kappas 0.1923

set -e
cd /work/gw97/w97000/project/DM/3Dphi4
[[ -f runs/phi4_3d_Lmulti4-8-16-32_k0.1923_l0.9_ncsnpp/data_crossL_mala/kc_ex100_2000_shard0/state.pt ]] \
    || { echo "ERROR: no shard state to resume"; exit 1; }
mkdir -p results/mala_pipeline_logs
echo "Job ${PBS_JOBID:-?}  start $(date '+%F %T')  nodes: $(uniq ${PBS_NODEFILE:-/dev/null} 2>/dev/null | tr '\n' ' ')"
if [[ "${PBS_JOBNAME:-}" != "dm3d_kc_exr" ]]; then
    echo "(not the dm3d_kc_exr job — preflight only)"; exit 0
fi
mpirun --map-by ppr:1:node -hostfile "${PBS_NODEFILE}" \
    bash /work/gw97/w97000/project/DM/3Dphi4/scripts/mala_kc_ex_resume_worker.sh
echo "Finished $(date '+%F %T')"
