#!/bin/bash -l
#PBS -q regular-g
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=18:00:00
#PBS -W group_list=gw97
#PBS -N modelb_zhmc_t0p5
#PBS -j oe
#PBS -o /work/gw97/w97000/project/DM/ModelB/runs/modelB_L32_zhmc_t0p5.pbs.log

# zlog Δt=0.5 的覆盖检验：Z/m²/M 区间收窄到 HMC 有效范围（数据缺则补），
# 训练超参与 zlog 版完全一致，训完从 Fig.2 两条链的初态各走 40 步到 t=20 并算统计。
set -euo pipefail

cd /work/gw97/w97000/project/DM/ModelB
export PATH=/work/gw97/w97000/envs/nenv2/bin:$PATH

echo "Job ID: ${PBS_JOBID}"
echo "Node: $(hostname)"
echo "Start: $(date '+%F %T')"
nvidia-smi -L

COND=trainingdata/modelB_L32_Ne51200_corrgausszhmc_l1_kappa_0.340340_t0_seed2026091701.jld2
TARGET=trainingdata/modelB_L32_Ne51200_corrgausszhmc_l1_kappa_0.340340_t0p5_dt0.0001_seed2026091702.jld2

if [[ ! -f ${TARGET} || ! -f ${COND} ]]; then
    rm -f "${COND}" "${TARGET}"
    /work/gw97/w97000/.local/bin/julia \
        data_generation/run_l32_l1_k0p340340_corrgauss_zhmc_t0p5.jl
fi

PYTHONUNBUFFERED=1 python -u train/train_modelB_cond.py \
    --L 32 \
    --kappa 0.34034 --lam 1.0 --horizon 0.5 \
    --sigma 250 --lr 0.001 --batch_size 64 \
    --epochs 10000 --ema_start 0 --num_ckpts 100 \
    --device cuda:0 --compile_mode reduce-overhead \
    --output_suffix _corrgauss_zhmc_noskip \
    --cond_path "${COND}" \
    --target_path "${TARGET}"

PYTHONUNBUFFERED=1 python -u sample/run_chains.py zhmc
MODELB_CHAIN_RUN=runs/modelBcond_L32_k0.34034_l1.0_t0.5_ncsnpp_corrgauss_zhmc_noskip \
    python -u analysis/chain_data.py

echo "Finish: $(date '+%F %T')"
