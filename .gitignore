# === git 初始化时补充（2026-06-20）===
# Core dump（程序崩溃转储，可达数 GB，例如 core.mg0022.python.107767）
core.*

# 集群作业输出（UGE/PBS 的 stdout/stderr，例如 dm3d_sample.o1978072）
*.o[0-9]*
*.e[0-9]*
*.po[0-9]*
*.pe[0-9]*

# numpy 压缩存档（与已忽略的 *.npy 保持一致）
*.npz

# 所有 PDF（论文/slides/figure 编译产物及文档，均不入库；源 .tex/脚本仍跟踪）
*.pdf

# Claude Code 本地配置（仅 settings.json 入库）
.claude/settings.local.json

