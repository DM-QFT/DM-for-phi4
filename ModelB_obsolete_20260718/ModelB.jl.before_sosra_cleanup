using CUDA,DifferentialEquations,DiffEqNoiseProcess, Plots, DelimitedFiles
using StochasticDiffEq, Statistics
const myT = Float32

limitbound(a, n) =
    if a == n + 1
        1
    elseif a == 0
        n
    else
        a
    end
# export limitbound

function limitbound2(a, n)
    if a == n + 1
        1
    elseif a == 0
        n
    elseif a == n + 2
        2
    elseif a == -1
        n - 1
    else
        a
    end
end
function update_2d_modelB!(dσ, σ, fun, dx, twoκ)
    N = size(σ, 1)
    id = (blockIdx().x - 1) * blockDim().x + threadIdx().x
    cind = CartesianIndices(σ)
    for i = id:blockDim().x*gridDim().x:prod(size(σ))
        x, y = Tuple(cind[i])
        xp1, xm1 = limitbound2(x + 1, N), limitbound2(x - 1, N)
        yp1, ym1 = limitbound2(y + 1, N), limitbound2(y - 1, N)
        xp2, xm2 = limitbound2(x + 2, N), limitbound2(x - 2, N)
        yp2, ym2 = limitbound2(y + 2, N), limitbound2(y - 2, N)
        @inbounds dσ[x, y] =
            (
                -20 * σ[x, y] + 8 * σ[x, ym1] - σ[x, ym2] + 8 * σ[x, yp1] - σ[x, yp2] +
                8 * σ[xm1, y] - 2 * σ[xm1, ym1] - 2 * σ[xm1, yp1] - σ[xm2, y] -
                2 * (-4 * σ[xp1, y] + σ[xp1, ym1] + σ[xp1, yp1]) - σ[xp2, y]
            ) * twoκ / dx^4 -
            (
                4 * fun(σ[x, y]) - fun(σ[xm1, y]) - fun(σ[xp1, y]) - fun(σ[x, yp1]) -
                fun(σ[x, ym1])
            ) / dx^2
    end
    return nothing
end


function update_conserve_noise_kernel!(
    dσ::AbstractArray{T,2},
    ξx::AbstractArray{T,2},
    ξy::AbstractArray{T,2},
    dx::T,
) where {T}
    N = size(dσ, 1)
    id = (blockIdx().x - 1) * blockDim().x + threadIdx().x
    cind = CartesianIndices(dσ)
    for i = id:blockDim().x*gridDim().x:prod(size(dσ))
        x, y = Tuple(cind[i])
        xm1 = limitbound(x - 1, N)
        ym1 = limitbound(y - 1, N)
        @inbounds dσ[x, y] =
            ((ξx[x, y] - ξx[xm1, y]) + (ξy[x, y] - ξy[x, ym1])) / dx
    end
    return nothing
end

function modelB_2d_loop_GPU(dσ, σ, fun, dx, twoκ)
    threads = 512
    blocks = 2^5
    @cuda blocks = blocks threads = threads maxregs = 4 update_2d_modelB!(dσ, σ, fun, dx, twoκ)
end

function conserve_noise_loop_GPU(dσ, ξx, ξy, dx)
    threads = 512
    blocks = 2^5
    @cuda blocks = blocks threads = threads maxregs = 4 update_conserve_noise_kernel!(dσ, ξx, ξy, dx)
end


function REAL_INPLACE_ModelB_NOISE_DIST(rand_vec, W, dt, u, p, t, rng)
    sqabsdt = @fastmath sqrt(abs(dt))
    p1, ξx, ξy = p
    DiffEqNoiseProcess.wiener_randn!(CUDA.default_rng(), ξx)
    DiffEqNoiseProcess.wiener_randn!(CUDA.default_rng(), ξy)
    #please change this 1.0f0 with the correct dx value if needed
    CUDA.@sync conserve_noise_loop_GPU(p1, ξx, ξy, 1.0f0)
    CUDA.@sync @. rand_vec = sqabsdt * p1
end

# exact bridge for the conserved noise: same covariance -∇², standard bridge formula
function REAL_INPLACE_ModelB_NOISE_BRIDGE(rand_vec, W, W0, Wh, q, h, u, p, t, rng)
    p1, ξx, ξy = p
    DiffEqNoiseProcess.wiener_randn!(CUDA.default_rng(), ξx)
    DiffEqNoiseProcess.wiener_randn!(CUDA.default_rng(), ξy)
    CUDA.@sync conserve_noise_loop_GPU(p1, ξx, ξy, 1.0f0)
    CUDA.@sync @. rand_vec = sqrt((1 - q) * q * abs(h)) * p1 + q * Wh
end


function RealModelBProcess!(t0, W0, Z0 = nothing; kwargs...)
    NoiseProcess{true}(
        t0,
        W0,
        Z0,
        REAL_INPLACE_ModelB_NOISE_DIST,
        REAL_INPLACE_ModelB_NOISE_BRIDGE;
        kwargs...,
    )
end



function modelB_2d_SDE_prob(;
    u0 = error("u0 not provided"),
    γ = 1.0f0,
    tspan = myT.((0.0, 15.0)),
    T = 1.0f0,
    κ = 0.27f0,
    λ = 0.022f0,
    dx = 1.0f0,
    solver = EM(),  # DRI1NM draws its own auxiliary RNGs -> breaks conservation; only EM/LambaEM/SOSRA/SRA are valid here
    save_start = false,
    save_everystep = false,
    save_end = false,
    abstol = 5e-2,
    reltol = 5e-2,
    with_Z = true,  # Z needed by SRA-type solvers only; with_Z=false saves ~22% for EM
    kwargs...,
)
    # 2Dphi4 action S = Σ[-2κ Σ_μ φφ' + (1-2λ)φ² + λφ⁴]:  δS/δφ = -2κ∇²φ + Ufun(φ)
    m02 = myT(2 * (1 - 2 * λ) - 8 * κ)
    c3 = myT(4 * λ)
    twoκ = myT(2 * κ)
    function Ufun(x)
        m02 * x + c3 * x^3
    end
    u0_GPU = CuArray(u0)
    GC.gc(true)
    CUDA.reclaim()
    function ODEfun_tex(dσ, σ, p, t)
        CUDA.@sync modelB_2d_loop_GPU(dσ, σ, Ufun, dx, twoκ)
        CUDA.@sync @. dσ = (1 / γ) * dσ
    end

    function g(du, u, p, t)
        du .= sqrt(2 * T / γ)
    end
    myp = (similar(u0_GPU), similar(u0_GPU), similar(u0_GPU))
    W_test = zero(u0_GPU)
    # Z0 provided: SRA-type solvers (SOSRA/SRA3) need the auxiliary Z process
    W = RealModelBProcess!(0.0f0, W_test, with_Z ? zero(u0_GPU) : nothing, save_everystep = false)
    sdeprob = SDEProblem(ODEfun_tex, g, u0_GPU, tspan, myp; noise = W)
    GC.gc(true)
    CUDA.reclaim()
    solve(
        sdeprob,
        solver;
        save_start = save_start,
        save_everystep = save_everystep,
        save_end = save_end,
        abstol = abstol,
        reltol = reltol,
        saveat = tspan[1]:(1f0):tspan[2],
        dt = 0.005f0,
        kwargs...,
    )
end

uini = randn(Float32, 256, 256)
uini .-= mean(uini)
solBSDE = modelB_2d_SDE_prob(
    u0 = uini,
    γ = 1.0f0,
    tspan = (0.0f0, 100f0),
    T = 1f0,
    solver = SOSRA(),
    abstol = 5f-1,
    reltol = 5f-1,
    dt = 1f-3,  # initial guess only, controller adapts; SDE auto-initdt fails on this stiff system
    save_start = true,
)
